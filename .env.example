# ============================================================
# Cámara CSI IMX219
# ============================================================
CAMERA_SENSOR_ID=0
CAMERA_CAPTURE_WIDTH=1920
CAMERA_CAPTURE_HEIGHT=1080
CAMERA_OUTPUT_WIDTH=960
CAMERA_OUTPUT_HEIGHT=540
CAMERA_FRAMERATE=30
CAMERA_FLIP_METHOD=0
CAMERA_READ_TIMEOUT_SECONDS=5
CAMERA_RECONNECT_SECONDS=5

# ============================================================
# Detección y reconocimiento facial
# ============================================================
HAAR_MODEL=models/haarcascade_frontalface_default.xml
FACES_DIR=data/faces
EVENTS_DIR=data/events

FACE_WIDTH=200
FACE_HEIGHT=200

DETECTION_SCALE_FACTOR=1.2
DETECTION_MIN_NEIGHBORS=5
DETECTION_MIN_SIZE=60

RECOGNITION_THRESHOLD=70
RECOGNITION_CONFIRM_FRAMES=3
UNKNOWN_CONFIRM_FRAMES=5

# ============================================================
# Gestión de eventos
# ============================================================
EVENT_COOLDOWN_SECONDS=30
EVENT_RETENTION_DAYS=30
SAVE_UNKNOWN_EVENTS=true

# ============================================================
# Servidor de streaming
# ============================================================
STREAM_ENABLED=true
STREAM_HOST=0.0.0.0
STREAM_PORT=8080
STREAM_JPEG_QUALITY=80
STREAM_MAX_FPS=15

# ============================================================
# Visualización local
# ============================================================
DISPLAY_ENABLED=false
DISPLAY_WINDOW_NAME=Jetson Nano Vision

# ============================================================
# Telegram
# ============================================================
TELEGRAM_ENABLED=false
TELEGRAM_COMMANDS_ENABLED=false

# Obtener el token mediante BotFather.
TELEGRAM_BOT_TOKEN=

# IDs numéricos separados por comas.
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_USER_CHAT_IDS=
TELEGRAM_NOTIFICATION_CHAT_IDS=

TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_RETRY_COUNT=3
TELEGRAM_POLL_TIMEOUT=25

# Mantener deshabilitado hasta configurar permisos de reinicio.
TELEGRAM_REBOOT_ENABLED=false
TELEGRAM_REBOOT_CONFIRM_TIMEOUT=60

# ============================================================
# Servicio systemd
# ============================================================
SYSTEMD_SERVICE_NAME=jetson-vision

# ============================================================
# Registros
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/jetson-vision.log
